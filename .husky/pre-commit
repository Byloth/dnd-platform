#!/bin/sh
# Nothing under private/ may be committed: it is the private submodule, of which only the pointer is tracked
# (docs/phase-0/06-private-packages.md).
private=$(git diff --cached --name-only --diff-filter=ACMR -- private | grep -v '^private$' || true)
if [ -n "$private" ]; then
    echo "pre-commit: refusing to commit private content:" >&2
    echo "$private" | sed 's/^/  /' >&2
    exit 1
fi

# The generated schemas and types must follow schemas/*.json (CI checks the same).
pnpm run generate:types:check
pnpm run lint
pnpm run typecheck
pnpm run test
