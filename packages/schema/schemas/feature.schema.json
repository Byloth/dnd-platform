{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-platform.byloth.dev/schema/v0/feature.schema.json",
  "title": "Feature",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/localizedString"
    },
    "text": {
      "$ref": "common.schema.json#/$defs/localizedString"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/sourceRef"
    },
    "tags": {
      "$ref": "common.schema.json#/$defs/tags"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "effect.schema.json"
      }
    },
    "choices": {
      "type": "array",
      "items": {
        "$ref": "choice.schema.json"
      }
    },
    "toggle": {
      "$ref": "common.schema.json#/$defs/toggle"
    },
    "onRest": {
      "type": "array",
      "items": {
        "$ref": "play-effect.schema.json"
      },
      "minItems": 1
    },
    "onTurnStart": {
      "type": "array",
      "items": {
        "$ref": "play-effect.schema.json"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name"
  ]
}
