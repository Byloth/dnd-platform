{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-platform.byloth.dev/schema/v0/ruleset.schema.json",
  "title": "Ruleset",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/rulesetId"
    },
    "abilities": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ability"
      },
      "minItems": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/skill"
          },
          "ability": {
            "$ref": "common.schema.json#/$defs/ability"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "ability"
        ]
      },
      "minItems": 1
    },
    "proficiencyBonus": {
      "type": "object",
      "properties": {
        "table": {
          "$ref": "common.schema.json#/$defs/entityId"
        }
      },
      "additionalProperties": false,
      "required": [
        "table"
      ]
    },
    "abilityModifier": {
      "$ref": "common.schema.json#/$defs/formula"
    },
    "hitPoints": {
      "type": "object",
      "properties": {
        "firstLevel": {
          "$ref": "common.schema.json#/$defs/formula"
        },
        "perLevel": {
          "$ref": "common.schema.json#/$defs/formula"
        }
      },
      "additionalProperties": false,
      "required": [
        "firstLevel",
        "perLevel"
      ]
    },
    "rests": {
      "type": "object",
      "properties": {
        "short": {
          "type": "object",
          "properties": {
            "hitDice": {
              "type": "string",
              "enum": [
                "spend",
                "none"
              ]
            },
            "hours": {
              "type": "integer",
              "minimum": 1,
              "description": "Length of a short rest; timed effects of at most this many hours end with it. Absent: timed effects do not elapse."
            }
          },
          "additionalProperties": false
        },
        "long": {
          "type": "object",
          "properties": {
            "hitPoints": {
              "type": "string",
              "enum": [
                "full",
                "none"
              ]
            },
            "hitDiceRecovered": {
              "$ref": "common.schema.json#/$defs/formula"
            },
            "conditionLevelsRecovered": {
              "type": "integer",
              "minimum": 0,
              "description": "Levels removed from every levelled condition (exhaustion) by a long rest; absent: none."
            },
            "hours": {
              "type": "integer",
              "minimum": 1,
              "description": "Length of a long rest; timed effects of at most this many hours end with it. Absent: timed effects do not elapse."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "short",
        "long"
      ]
    },
    "spellSlots": {
      "type": "object",
      "properties": {
        "full": {
          "type": "object",
          "properties": {
            "table": {
              "$ref": "common.schema.json#/$defs/entityId"
            }
          },
          "additionalProperties": false,
          "required": [
            "table"
          ]
        },
        "half": {
          "type": "object",
          "properties": {
            "table": {
              "$ref": "common.schema.json#/$defs/entityId"
            }
          },
          "additionalProperties": false,
          "required": [
            "table"
          ]
        },
        "third": {
          "type": "object",
          "properties": {
            "table": {
              "$ref": "common.schema.json#/$defs/entityId"
            }
          },
          "additionalProperties": false,
          "required": [
            "table"
          ]
        },
        "pact": {
          "type": "object",
          "properties": {
            "table": {
              "$ref": "common.schema.json#/$defs/entityId"
            }
          },
          "additionalProperties": false,
          "required": [
            "table"
          ]
        },
        "multiclass": {
          "type": "object",
          "properties": {
            "table": {
              "$ref": "common.schema.json#/$defs/entityId"
            },
            "casterLevel": {
              "$ref": "common.schema.json#/$defs/formula"
            }
          },
          "additionalProperties": false,
          "required": [
            "table",
            "casterLevel"
          ]
        }
      },
      "additionalProperties": false
    },
    "baseActions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityId"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityId"
      }
    },
    "concentration": {
      "type": "object",
      "description": "Concentration rules read by the play engine; absent: no concentration check is reported.",
      "properties": {
        "saveDc": {
          "$ref": "common.schema.json#/$defs/formula",
          "description": "DC of the saving throw to keep concentrating after taking damage; `damage` is bound to the damage taken."
        }
      },
      "additionalProperties": false,
      "required": [
        "saveDc"
      ]
    },
    "deathSaves": {
      "type": "object",
      "description": "Death saving throw rules read by the play engine; absent: the death-save event is rejected.",
      "properties": {
        "dc": {
          "type": "integer",
          "minimum": 1
        },
        "successes": {
          "type": "integer",
          "minimum": 1,
          "description": "Successes that stabilise the character."
        },
        "failures": {
          "type": "integer",
          "minimum": 1,
          "description": "Failures that kill the character."
        },
        "natural20": {
          "type": "object",
          "properties": {
            "hitPoints": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "hitPoints"
          ],
          "description": "A natural 20 regains this many hit points instead of counting as a success."
        },
        "natural1": {
          "type": "object",
          "properties": {
            "failures": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "failures"
          ],
          "description": "Failures counted on a natural 1."
        },
        "damage": {
          "type": "object",
          "properties": {
            "failures": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "failures"
          ],
          "description": "Failures counted when the character takes damage at 0 hit points."
        }
      },
      "additionalProperties": false,
      "required": [
        "dc",
        "successes",
        "failures"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "abilities",
    "skills",
    "proficiencyBonus",
    "abilityModifier",
    "hitPoints",
    "rests"
  ],
  "description": "Ruleset (base packages)"
}
