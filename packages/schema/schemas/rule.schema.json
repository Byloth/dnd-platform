{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-platform.byloth.dev/schema/v0/rule.schema.json",
  "title": "Rule",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/localizedString"
    },
    "text": {
      "$ref": "common.schema.json#/$defs/localizedString"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/sourceRef"
    },
    "tags": {
      "$ref": "common.schema.json#/$defs/tags"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "action",
        "movement",
        "cover",
        "rest",
        "combat",
        "spellcasting",
        "condition",
        "ability",
        "general"
      ]
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/localizedString"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "text",
    "category"
  ]
}
