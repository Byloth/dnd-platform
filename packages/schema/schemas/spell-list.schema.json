{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-platform.byloth.dev/schema/v0/spell-list.schema.json",
  "title": "SpellList",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/localizedString"
    },
    "text": {
      "$ref": "common.schema.json#/$defs/localizedString"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/sourceRef"
    },
    "tags": {
      "$ref": "common.schema.json#/$defs/tags"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "spells": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityId"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "spells"
  ],
  "description": "Spell list"
}
