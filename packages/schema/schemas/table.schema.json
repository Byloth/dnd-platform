{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-platform.byloth.dev/schema/v0/table.schema.json",
  "title": "Table",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/localizedString"
    },
    "text": {
      "$ref": "common.schema.json#/$defs/localizedString"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/sourceRef"
    },
    "tags": {
      "$ref": "common.schema.json#/$defs/tags"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "by": {
      "$ref": "common.schema.json#/$defs/tableBy"
    },
    "rows": {
      "$ref": "common.schema.json#/$defs/tableRows"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "by",
    "rows"
  ]
}
