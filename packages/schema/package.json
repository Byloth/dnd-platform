{
  "name": "@byloth/dnd-platform-schema",
  "version": "0.0.0",
  "description": "JSON Schemas and generated TypeScript types of the dnd-platform content format.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "json-schema-to-typescript": "^16.0.0",
    "yaml": "^2.9.1"
  }
}
