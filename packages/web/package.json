{
  "name": "@byloth/dnd-platform-web",
  "version": "0.0.0",
  "description": "The web application of the platform: guided character creation, dynamic sheet, print. Static, runs entirely in the browser.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "budgets": "node scripts/check-budgets.ts",
    "a11y": "node scripts/check-accessibility.ts",
    "pwa": "node scripts/check-pwa.ts",
    "repeat-visit": "node scripts/check-repeat-visit.ts; status=$?; rm -rf -- *repeat-visit-*; exit $status",
    "lighthouse": "lhci autorun; status=$?; rm -rf -- *AppData*lighthouse.*; exit $status",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "prepare-content": "node scripts/prepare-content.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@byloth/core": "^3.0.2",
    "@byloth/dnd-platform-composer": "workspace:*",
    "@byloth/dnd-platform-engine": "workspace:*",
    "@byloth/dnd-platform-loader": "workspace:*",
    "@byloth/dnd-platform-schema": "workspace:*",
    "@byloth/dnd-platform-sheets": "workspace:*",
    "@byloth/exceptions": "^2.3.1",
    "@byloth/nuxt-vuert-module": "^2.0.0-dev.1",
    "@byloth/vuert": "^2.0.0-dev.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "1.0.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^15.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "modern-normalize": "^3.0.1",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@byloth/eslint-config-nuxt": "^4.0.2",
    "@lhci/cli": "^0.16.0",
    "@nuxt/test-utils": "^4.3.4",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "lighthouse": "^13.6.0",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.16.0",
    "sass": "^1.107.1",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1"
  }
}
