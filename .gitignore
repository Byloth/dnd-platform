# Files created by OS
#
.DS_Store
Desktop.ini

# Files created by IDE
#
/.idea/
/.vscode/

/*.code-workspace

# Downloadable & installable modules & components
#
node_modules/

# Generated & compiled files
#
dist/
coverage/
*.tsbuildinfo

# Canonical JSON bundles written by `dnd build` (the private ones land under content-private/build/)
#
/build/

# The web application: Nuxt's generated files and the content copied into the site
#
.nuxt/
.output/
/packages/web/public/content/

# Environmental files
#
.env
.env.*

# Log files
#
*.log

# Copyrighted content: same package format, never committed (only its README is tracked)
#
/content-private/*
!/content-private/README.md

# Downloaded upstream datasets of the SRD import pipeline
#
/tools/import/cache/

# Stray documents at the repository root
#
/*.pdf

# Not ignored
#
!.gitkeep

# Intermediate outputs of the import pipeline
#
/tools/import/work/
